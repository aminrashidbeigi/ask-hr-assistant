# --- LLM -------------------------------------------------------------------------------------
# Gemini by default (free key at https://aistudio.google.com/apikey). The free tier has small per-model
# daily request caps, so chat fails over from CHAT_MODEL to CHAT_MODEL_FALLBACK when a quota is hit.
CHAT_PROVIDER=google         # google | openai
# CHAT_MODEL=                # google: gemini-2.5-flash | openai: gpt-4o-mini
# CHAT_MODEL_FALLBACK=       # google: gemini-3.5-flash-lite | openai: none; "none" disables failover
# JUDGE_MODEL=               # google: gemini-3.5-flash | openai: gpt-4o (eval only)
GOOGLE_GENERATIVE_AI_API_KEY=   # also used for embeddings when EMBEDDING_PROVIDER=google
OPENAI_API_KEY=                 # only for CHAT_PROVIDER / EMBEDDING_PROVIDER = openai
# Embeddings are stored as 1536 dims; changing provider/model needs `pnpm ingest --force`.
EMBEDDING_PROVIDER=google    # google | openai | mock (mock = deterministic fake vectors, for CI)
EMBEDDING_MODEL=gemini-embedding-001

# --- Database (Neon pooled URL in cloud, docker compose locally) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=   # optional direct connection, used for migrations (Neon provides it)

# --- Retrieval ---
RETRIEVAL_MODE=hybrid       # hybrid | vector
MIN_RELEVANCE=0
MAX_VECTOR_DISTANCE=0.33     # best cosine distance above which nothing counts as relevant
TOP_K=6

# --- Langfuse (optional but recommended) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=

# --- Rate limiting (optional; falls back to in-memory) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin dashboard (basic auth) ---
ADMIN_USER=
ADMIN_PASSWORD=

# --- Budget guard ---
DAILY_BUDGET_USD=2
