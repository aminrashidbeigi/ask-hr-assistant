# --- LLM (Gemini free tier by default; get a key at https://aistudio.google.com/apikey) ---
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=              # only needed when CHAT_PROVIDER / EMBEDDING_PROVIDER = openai
CHAT_PROVIDER=google         # google | openai
CHAT_MODEL=gemini-2.5-flash
JUDGE_MODEL=gemini-3.5-flash
EMBEDDING_PROVIDER=google    # google | openai | mock (mock = deterministic fake vectors, for CI)
EMBEDDING_MODEL=gemini-embedding-001   # always stored as 1536 dims

# --- Database (Neon pooled URL in cloud, docker compose locally) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=   # optional direct connection, used for migrations (Neon provides it)

# --- Retrieval ---
RETRIEVAL_MODE=hybrid       # hybrid | vector
MIN_RELEVANCE=0
TOP_K=6

# --- Langfuse (optional but recommended) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=

# --- Rate limiting (optional; falls back to in-memory) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin dashboard (basic auth) ---
ADMIN_USER=
ADMIN_PASSWORD=

# --- Budget guard ---
DAILY_BUDGET_USD=2
