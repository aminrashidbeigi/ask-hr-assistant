# --- LLM (Gemini free tier by default; get a key at https://aistudio.google.com/apikey) ---
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=             # only needed when CHAT_PROVIDER=mistral (free "Experiment" plan, EU-hosted)
OPENAI_API_KEY=              # only needed when CHAT_PROVIDER / EMBEDDING_PROVIDER = openai
CHAT_PROVIDER=google         # google | mistral | openai  (mistral: set CHAT_MODEL=mistral-small-latest, JUDGE_MODEL=mistral-large-latest, CHAT_MODEL_FALLBACK=none)
CHAT_MODEL=gemini-2.5-flash            # fast, but free tier is only ~5 requests/min
CHAT_MODEL_FALLBACK=gemini-3.5-flash-lite  # used when the primary hits quota/overload (~15/min, slower); "none" disables
JUDGE_MODEL=gemini-3.5-flash         # own quota pool, so judging does not compete with chat
EMBEDDING_PROVIDER=google    # google | openai | mock (mock = deterministic fake vectors, for CI)
EMBEDDING_MODEL=gemini-embedding-001   # always stored as 1536 dims

# --- Database (Neon pooled URL in cloud, docker compose locally) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=   # optional direct connection, used for migrations (Neon provides it)

# --- Retrieval ---
RETRIEVAL_MODE=hybrid       # hybrid | vector
MIN_RELEVANCE=0
MAX_VECTOR_DISTANCE=0.33     # best cosine distance above which nothing counts as relevant
TOP_K=6

# --- Langfuse (optional but recommended) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=

# --- Rate limiting (optional; falls back to in-memory) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin dashboard (basic auth) ---
ADMIN_USER=
ADMIN_PASSWORD=

# --- Budget guard ---
DAILY_BUDGET_USD=2
