# --- LLM ---
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=openai   # openai | mock (mock = deterministic fake vectors, for CI)

# --- Database (Neon pooled URL in cloud, docker compose locally) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=   # optional direct connection, used for migrations (Neon provides it)

# --- Retrieval ---
RETRIEVAL_MODE=hybrid       # hybrid | vector
MIN_RELEVANCE=0
TOP_K=6

# --- Langfuse (optional but recommended) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=

# --- Rate limiting (optional; falls back to in-memory) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin dashboard (basic auth) ---
ADMIN_USER=
ADMIN_PASSWORD=

# --- Budget guard ---
DAILY_BUDGET_USD=2
